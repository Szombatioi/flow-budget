# Copy to .env next to docker-compose.yml and adjust. Generate every secret; never reuse the example values.

# Image tag to run: latest, or sha-<commit> to pin a build.
FLOWBUDGET_TAG=latest

# Domain served by Traefik. The app's public URL (BETTER_AUTH_URL) becomes https://<APP_DOMAIN>.
APP_DOMAIN=budget.example.com
# Must match your Traefik setup: its external Docker network, HTTPS entrypoint and certificate resolver.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# PostgreSQL
POSTGRES_DB=flowbudget
POSTGRES_USER=flowbudget
# e.g. `openssl rand -hex 24`. Part of the database URL, so avoid characters such as / @ : # ? %
POSTGRES_PASSWORD=change-me

# Comma-separated list of extra origins allowed to call the auth API, e.g. https://www.budget.example.com
# TRUSTED_ORIGINS=
# At least 32 random characters, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-value-0000000000

# Registration: set to true once every account you need exists. Existing users can still sign in.
DISABLE_SIGN_UP=false
# Password rules for registration and password changes.
MIN_PASSWORD_LENGTH=12
# At least three of: lowercase, uppercase, digit, symbol.
PASSWORD_REQUIRE_COMPLEXITY=true
# Reject passwords found in known breaches (Have I Been Pwned; only a 5-character hash prefix is sent).
# Needs outbound HTTPS to api.pwnedpasswords.com.
PASSWORD_CHECK_PWNED=false

# Envelope encryption of expenditure names/descriptions and API keys.
# local: key encryption keys come from KMS_LOCAL_KEYS ("<version>:<base64 32-byte key>", comma separated);
#        generate one with `openssl rand -base64 32`. Keep old versions when rotating.
# vault: HashiCorp Vault transit engine (VAULT_ADDR, VAULT_TOKEN, VAULT_KEY_NAME).
KMS_PROVIDER=local
KMS_CURRENT_KEY_VERSION=1
KMS_LOCAL_KEYS=1:replace-with-output-of-openssl-rand-base64-32=
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=
# VAULT_KEY_NAME=flowbudget-kek

# Receipt scanning (users supply their own Gemini API key in Settings).
GEMINI_MODEL=gemini-3.1-flash-lite

# "Today" for the budget is evaluated in this timezone.
TZ=Europe/Budapest
