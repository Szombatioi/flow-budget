# Copy this file to `.env` at the repo root and fill in the values.
# `docker compose -f docker-compose.prod.yml` will pick it up automatically.

# --- Public URL where the app will be reachable ---------------------------
# The WASM client is downloaded from here and calls the API through it.
# MUST end with a trailing slash. Use https:// if you terminate TLS at a proxy.
PUBLIC_BASE_URL=https://flowbudget.example.com/

# --- Host port mapping ----------------------------------------------------
# Container listens on 5288 (HTTPS). If you put a reverse proxy in front,
# you may want to bind this only to 127.0.0.1 by editing the compose file.
APP_HTTPS_PORT=5288

# --- SQL Server -----------------------------------------------------------
# Strong password required by Azure SQL Edge (>= 8 chars, upper+lower+digit).
SQL_SA_PASSWORD=CHANGE_ME_ToAStrongPassword_123!

# --- Kestrel HTTPS cert ---------------------------------------------------
# The Dockerfile bakes a self-signed cert with this password.
# Replace the cert (see compose-files/prod/README.md) for a real deployment.
CERT_PASSWORD=FlowBudget_Cert!

# --- Seeded admin account -------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@flowbudget.example.com
ADMIN_PASSWORD=CHANGE_ME_AdminPassword_123!

# --- Email notifications (optional; leave EMAIL_HOST empty to disable) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SENDER=
EMAIL_SENDER_NAME=FlowBudget
EMAIL_PASSWORD=
